# Copy this file to .env and fill in your actual values.

# Google Analytics 4 Measurement ID (Analytics Admin > Data Streams).
# Leave unset locally — analytics is a no-op without a valid G-XXXX id,
# so dev traffic never pollutes production data.
VITE_GA_MEASUREMENT_ID=

# API key for the hosted LLM gateway used by the "AI Twin" chat widget.
# Leave unset locally — the chat falls back to curated offline answers.
VITE_GATEWAY_API_KEY=
